# Kopie als .env.local anlegen. .env.local wird nie committet.

# Aus Supabase: Settings -> API Keys
NEXT_PUBLIC_SUPABASE_URL=https://DEINPROJEKT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# GEHEIM. Nur Server. Darf nie mit NEXT_PUBLIC_ anfangen.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# GEHEIM. Zufaelliger Wert, mischt sich in den Code-Hash.
# Erzeugen mit:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INVITE_CODE_PEPPER=

# Interne Mail-Domain fuer die technischen Konten. Es wird nie eine Mail versendet.
INVITE_EMAIL_DOMAIN=invite.local

# Nach wie vielen Minuten ohne Eingabe der Chat sich sperrt.
NEXT_PUBLIC_IDLE_MINUTES=5
